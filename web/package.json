{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "fixture": "tsx scripts/make-fixture.ts",
    "fixture:degenerate": "tsx scripts/make-fixture.ts --degenerate",
    "data": "python3 -m pipeline.export_matrix --out public/data/matrix.json --quotes-out public/data/quotes.json",
    "oracle": "python3 -m score_calculation.score --matrix public/data/matrix.json --out ../data/scores_oracle.csv",
    "verify:oracle": "tsx scripts/verify-oracle.ts"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.169.0",
    "@react-three/fiber": "^8.17.10",
    "@react-three/drei": "^9.114.3"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.169.0",
    "@types/node": "^22.9.0",
    "@vitejs/plugin-react": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.5",
    "tsx": "^4.19.2"
  }
}
