# This machine has an unrelated project's node_modules/package-lock.json in
# the home directory, which npm's ancestor-tree scan picks up during peer
# resolution and misattributes as a conflict against our own deps. This repo
# has nothing to do with that project; legacy-peer-deps sidesteps the bogus
# conflict rather than us pinning around packages we don't use.
legacy-peer-deps=true
